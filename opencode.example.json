{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "mimo-vision": {
      "type": "local",
      "command": [
        "<你的python绝对路径>",
        "-m",
        "mimo_vision_mcp.server"
      ],
      "enabled": true,
      "environment": {
        "MIMO_API_KEY": "{env:MIMO_API_KEY}"
      }
    }
  },
  "experimental": {
    "mcp_timeout": 120000
  }
}
