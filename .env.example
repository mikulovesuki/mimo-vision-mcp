# API Key（必填）— 使用 OpenCode Go 套餐
# 获取方式: 登录 https://opencode.ai/auth 订阅 Go 后复制你的 API Key
MIMO_API_KEY=

# 可选配置（均有默认值）
# 默认已指向 OpenCode Go 端点（OpenAI 兼容，模型 mimo-v2.5）
# 若改用小米官方 API，可切换为:
#   按量付费: https://api.xiaomimimo.com/v1
#   Token Plan: https://token-plan-cn.xiaomimimo.com/v1
MIMO_BASE_URL=https://opencode.ai/zen/go/v1

# 视觉模型 ID
MIMO_MODEL=mimo-v2.5

# 单次输出最大 token 数
MIMO_MAX_TOKENS=4096

# 请求超时（秒）
MIMO_TIMEOUT=120
